{
  "name": "test-auditor",
  "version": "1.0.0",
  "description": "Audit Jest test suites: coverage, static analysis, interactive reports, and backend upload",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "test-auditor": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --outDir dist && mkdir -p dist/config && cp config/cms-registry.json dist/config/cms-registry.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "viewer": "npx --yes serve viewer -p 4173"
  },
  "keywords": [
    "jest",
    "testing",
    "audit",
    "coverage",
    "nextjs",
    "test-quality",
    "cli"
  ],
  "author": "",
  "files": [
    "dist",
    "config",
    "viewer",
    "README.md",
    ".env.example",
    ".test-auditor.json.example"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "execa": "^10.0.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
